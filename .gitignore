# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large raw data; cleaned output is tracked)
data/*
!data/cleaned_markdown/
!data/cleaned_markdown/**
# B4/B5 deliverables must be tracked: verify_db.py hard-fails without the
# pinned hash manifest, and the plan requires changelog/logs/sign-off to be part
# of the handover. The bulky frozen step3 JSON inputs stay ignored.
!data/chunk/
data/chunk/*
# The 6 frozen step3 JSON inputs MUST be tracked: seed_legal.py reads them and
# verify_db.py V7 checks them against the pinned manifest. A clone without them
# cannot seed and fails V7 even after importing handoff/*.dump.
!data/chunk/chunks_*.json
!data/chunk/document_tree_*.json
!data/chunk/step3_stats.json
!data/chunk/low_confidence_refs.json
!data/chunk/source_manifest.json
# step3 deliverables that moved out of data_pipeline_steps/step3/output/.
# validation_report.md was tracked there and was deleted in d876159 -- it has to
# be tracked here or it leaves the repository entirely.
!data/chunk/CHANGELOG.md
!data/chunk/validation_report.md
!data/chunk/references_sample_review.md
!data/chunk/references_sample_review.csv
!data/chunk/deep_sweep.log
!data/chunk/CHANGELOG_B4B5.md
!data/chunk/mutation_test_report.md
!data/chunk/verify_db_manual.md
*.db
*.sqlite3

# Logs
logs/
*.log
# ...except the B4/B5 verification logs, which are part of the handover
# evidence. These must stay BELOW `*.log` because git honours the last matching
# pattern.
!data/chunk/verify_db_*.log
!data/chunk/mutation_test_*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/
