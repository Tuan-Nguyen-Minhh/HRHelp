{
  "family": "p029-ai20k-api",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${ECS_EXECUTION_ROLE_NAME}",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "${CONTAINER_NAME}",
      "image": "public.ecr.aws/docker/library/python:3.11-slim",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "http-8000",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "APP_ENV",
          "value": "production"
        },
        {
          "name": "APP_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "APP_PORT",
          "value": "8000"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "${CORS_ORIGINS}"
        }
      ],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "${DB_USER_SECRET}"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${DB_PASSWORD_SECRET}"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "${DB_HOST_SECRET}"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "${DB_NAME_SECRET}"
        },
        {
          "name": "MISTRAL_API_KEY",
          "valueFrom": "${MISTRAL_API_KEY_SECRET}"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "${JWT_SECRET_SECRET}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${ECS_LOG_GROUP}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\""
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
