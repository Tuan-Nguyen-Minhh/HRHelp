{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "ai-log-prompt",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=grok",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "ai-log-stop",
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=grok",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
