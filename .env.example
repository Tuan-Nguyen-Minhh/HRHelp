# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Clarify semantic planner (OpenAI-compatible SpaceXAI API). Without this key
# a chat turn still asks for missing facts and does not retrieve passages.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# ---- Database ----
# NOTE: src/core/config.py reads these DB_* keys. It does NOT read
# DATABASE_URL -- a DATABASE_URL line here would be silently ignored and the
# app would still fail with "DB_USER Field required".
# Only DB_USER / DB_PASSWORD / DB_NAME are mandatory; host/port have defaults.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=build_phase_p029

# Compose builds the URI from the DB_* keys above; kept here for reference only.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/build_phase_p029
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store (pgvector, same Postgres database) ----
# DECISION 2026-09-26, P-029: mistral-embed (1024-dim). The old
# text-embedding-3-small value was a stale template default and does NOT match
# src/core/config.py or src/services/vector_store.py. The 1536-dim
# document_chunks.embedding on main belongs to the HR Help bounded context
# (OpenAI embeddings for uploaded files), not to the legal corpus.
VECTOR_COLLECTION=regulations
EMBEDDING_MODEL=mistral-embed
# B6 (legal corpus embedding) and B7 (query embedding at search time) both call
# the Mistral embeddings endpoint. Without this key
# src.services.embeddings_client.EmbeddingClient refuses to start rather than
# failing halfway through a run. Team quota for this key: 20M TPM / 1 RPS — the
# 1 RPS ceiling is enforced in code (see src/services/embeddings_client.py) and
# every request is logged to data/chunk/embed_api_calls.jsonl.
MISTRAL_API_KEY=your-mistral-key-here
# CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Auth ----
# Access token embeds roles and permissions. Refresh loads them again from the database.
# Replace the placeholder before any shared environment.
JWT_SECRET=change-me-in-env-before-you-share
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
